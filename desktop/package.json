{
  "name": "aytratyn-gozegcilikde-saklamak-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop installer for Aýratyn gözegçilikde saklamak",
  "author": "atasanbratan",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.atasanbratan.aytratyngozegcilik",
    "productName": "Aytratyn Gozegcilik",
    "compression": "normal",
    "electronLanguages": ["en-US"],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client/dist"
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!data/**"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ],
      "artifactName": "${productName} Setup ${version} Win7-8 x86.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "atasanbratan",
      "repo": "harby-lukmancylyk-hasabaty"
    }
  },
  "lavamoat": {
    "allowScripts": {
      "electron#22.3.27": true
    }
  }
}
